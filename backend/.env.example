# Local frontend origin allowed by CORS
WEBSITE=http://localhost:3000

# Express API port
PORT=3001

# Owner login password
APP_PASSWORD=replace-with-a-long-unique-password

# Runtime mode: development or production
NODE_ENV=development

# Set to 1 only when running behind one trusted reverse proxy
TRUST_PROXY=0

# Requests allowed per client each minute
RATE_LIMIT_PER_MINUTE=300

# Optional custom runtime-data directory
# MOVIE_TRACKER_DATA_DIR=C:\path\to\cinevault-data

# Calendar timezone used when generating watch timestamps
MOVIE_TRACKER_TIME_ZONE=Asia/Kolkata

# Age before an unchanged poster or trailer is checked again
ASSET_SCAN_COOLDOWN_HOURS=24

# Operational logging level
LOG_LEVEL=info

# Backup retention
MANUAL_BACKUP_RETENTION=10
AUTOMATIC_DAILY_RETENTION_DAYS=30
AUTOMATIC_MONTHLY_RETENTION_MONTHS=12

# Optional encrypted off-device backup
# BACKUP_MIRROR_DIR=D:\CineVault-Backups
# BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-unique-secret

# Normally leave disabled; production deployments with an existing
# SQLite database may set this to 1.
MOVIE_TRACKER_SKIP_LEGACY_IMPORT=0